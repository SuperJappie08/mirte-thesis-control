<?xml version="1.1" encoding="UTF-8"?>
<launch>
  <arg name="audit-progress" default="False" />

  <arg name="controller_name" />

  <arg name="measurement_type" default="freq-prelim" />
  <arg name="measurement_name"
    default="$(var measurement_type)-$(eval 'datetime.datetime.now().isoformat(timespec=\'minutes\').replace(\':\', \'\')' datetime)" />
  <log message="Starting measurement '$(var measurement_name)'" />

  <arg name="measurements_folder" default="~/thesis/measurements" />
  <let name="storage_location"
    value="$(eval '\'$(var measurements_folder)\'.rstrip(\'/\')')/$(var measurement_name)" />
  <log message="Saving the measurements to $(var storage_location)" />

  <arg name="measurement_duration" default="5.0" />

  <arg name="hw_interface">
    <choice value="service_based" />
    <choice value="multimotor_topic_based" />
    <choice value="singlemotor_topic_based" />
  </arg>

  <group>
    <let name="launch-prefix" value="xterm -geometry 160x2 -e" if="$(var audit-progress)" />

    <let name="recorded_topics"
      value="/io/encoder/front_left;/io/encoder/front_right;/io/encoder/rear_left;/io/encoder/rear_right" />

    <let name="recorded_topics"
      value="$(var recorded_topics);/io/motor/motorservocontroller/multi_speed"
      if="$(equals '$(var hw_interface)' 'multimotor_topic_based')" />
    <let name="recorded_topics"
      value="$(var recorded_topics);/io/motor/front_left/speed;/io/motor/front_right/speed;/io/motor/rear_left/speed;/io/motor/rear_right/speed"
      if="$(equals '$(var hw_interface)' 'singlemotor_topic_based')" />

    <let name="recorded_services"
      value="/io/motor/motorservocontroller/set_multiple_speeds"
      if="$(equals '$(var hw_interface)' 'service_based')" />


    <node pkg="wheel_response_recorder" exec="response_director" on_exit="shutdown" output="screen"
      emulate_tty="true">
      <param name="progressbar" value="$(var audit-progress)" />
      <param name="storage_location" value="$(var storage_location)" />

      <param name="controller_name" value="$(var controller_name)" />

      <param name="recorded_services" value="$(var recorded_services)" value-sep=";" />
      <param name="recorded_topics" value="$(var recorded_topics '')" value-sep=";" />

      <param name="measurement_duration" value="$(var measurement_duration)" />

      <param name="sinusoid">
        <param name="amplitude">
          <param name="kind" value="fixed" />
          <param name="value" value="2.5" />
        </param>

        <param name="frequency">
          <param name="kind" value="log" />
          <param name="start" value="-2.0" />
          <!-- TODO: MAKE CONFIGURABLE OR SOMETHING, BUT CURRENTLY LOW BECAUSE OF CONTROLLER MANAGER
        LIMIT -->
          <param name="stop" value="1.0" />
          <param name="num_steps" value="40" />
        </param>

        <param name="phase">
          <param name="kind" value="fixed" />
          <param name="value" value="0.0" />
        </param>

        <param name="offset">
          <param name="kind" value="linear" />
          <!-- TODO: EXPOSE and posibly iter -->
          <param name="start" value="0.0" />
          <param name="stop" value="3.0" />
          <param name="num_steps" value="2" />
        </param>
      </param>
    </node>
  </group>
</launch>