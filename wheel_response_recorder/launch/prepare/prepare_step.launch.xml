<launch>
  <include file="$(find-pkg-share wheel_response_recorder)/launch/prepare/deactivate_normal_controllers.launch.xml" >
    <arg name="control_setup" value="$(var control_setup)" />
  </include>

  <spawn_controller final_controller_state="inactive">
    <controller name="multi_wheel_step_controller">
      <param from="$(find-pkg-share wheel_response_recorder)/config/multi_wheel_step_controller.yaml"/>
    </controller>
  </spawn_controller>
</launch>
