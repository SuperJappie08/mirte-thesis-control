<launch>
  <arg name="robot_version" default="mirte_master">
    <!-- The original MIRTE Master -->
    <choice value="mirte_master" />
  </arg>
  <arg name="control_setup">
    <!-- The original MIRTE control method -->
    <choice value="service_based" />
    <choice value="topic_based" />
  </arg>

  <executable
    cmd="ros2 control switch_controllers --deactivate mirte_base_controller pid_wheels_controller" />

  <executable
    cmd="ros2 param set io/telemetrix modules.motorservocontroller.service_introspection true"
    if="$(and $(equals $(var control_setup) 'service_based') $(equals $(var robot_version) 'mirte_master'))" />
</launch>
