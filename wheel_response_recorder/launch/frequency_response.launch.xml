<?xml version="1.1" encoding="UTF-8"?>
<!-- NOTE(SuperJappie08): Currently not used yet -->
<launch>
  <arg name="audit-progress" default="False" />

  <arg name="controller_name" default="multi_wheel_response_controller" />

  <include file="$(find-pkg-share wheel_response_recorder)/launch/arguments/hw_interface.launch.xml">
    <arg name="hw_interface" value="$(var hw_interface)" />
  </include>

  <arg name="measurement_postfix" default=""
    description="A post fix, which will be put between the measurement type and the date" />

  <!-- FIXME: Add correct parameter file options -->
  <arg name="sinusoid_param_file" default="frequency_offset.yaml"
    description="The frequency response parameter iteration configuration file (located in config/measurement)" />

  <let name="ansi-escape" value="$(eval 'chr(0o33)')" />
  <let name="todo-block" value="$(var ansi-escape)[1;93m[TODO]$(var ansi-escape)[0m"/>
  <log message="$(var todo-block) This measurement configuration is incomplete"/>
  <shutdown/>

  <arg name="sinusoid_param_fullpath"
    default="$(find-pkg-share wheel_response_recorder)/config/measurement/$(var sinusoid_param_file)"
    description="The sinusoid parameter iteration configuration file (full path)" />

  <arg name="measurements_folder" default="~/thesis/measurements" />

  <arg name="measurement_duration" default="5.0" />

  <arg name="extra_notes" default="" description="Extra notes to store with the measurements" />
  <arg name="manual" default="False" description="Wait for continue service call between measurements"/>

  <group forwarding="False">
    <keep name="audit-progress" value="$(var audit-progress)" />
    <keep name="controller_name" value="$(var controller_name)" />

    <keep name="hw_interface" value="$(var hw_interface)" />
    <keep name="measurement_postfix" value="$(var measurement_postfix)" />

    <keep name="sinusoid_param_fullpath" value="$(var sinusoid_param_fullpath)" />

    <keep name="measurements_folder" value="$(var measurements_folder)" />
    <keep name="measurement_duration" value="$(var measurement_duration)" />

    <keep name="extra_notes" value="$(var extra_notes)" />
    <keep name="manual" value="$(var manual)" />

    <include file="$(find-pkg-share wheel_response_recorder)/launch/measure.launch.xml">
      <arg name="audit-progess" value="$(var audit-progress)" />
      <arg name="controller_name" value="$(var controller_name)" />

      <!-- Measurement type -->
      <arg name="measurement_type" value="freq" />
      <arg name="enable_hw_type_id" value="True" />
      <arg name="hw_type_postfix" value="$(var measurement_postfix)" />

      <arg name="parameter_filepath" value="$(var sinusoid_param_fullpath)" />

      <arg name="measurements_folder" value="$(var measurements_folder)" />

      <arg name="measurement_duration" value="$(var measurement_duration)" />

      <arg name="hw_interface" value="$(var hw_interface)" />

      <arg name="extra_notes" value="$(var extra_notes)" />
      <arg name="manual" value="$(var manual)" />
    </include>
  </group>
</launch>
